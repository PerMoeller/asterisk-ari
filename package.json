{
  "name": "@per_moeller/asterisk-ari",
  "version": "1.1.0",
  "description": "Modern TypeScript ARI (Asterisk REST Interface) client with WebSocket reconnection and full API coverage",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "prepublishOnly": "node .github/scripts/ci-only-publish.mjs && npm run build"
  },
  "keywords": [
    "asterisk",
    "ari",
    "voip",
    "telephony",
    "pbx",
    "websocket",
    "typescript"
  ],
  "author": "Per Moeller",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PerMoeller/asterisk-ari.git"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
